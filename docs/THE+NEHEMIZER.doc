resource-container-id=3D"147423234" data-linked-resource-container-version=
=3D"2" data-media-id=3D"d77ce589-e249-42ed-93f5-89d95a346d6d" data-media-ty=
pe=3D"file" height=3D"468"></span>
<p local-id=3D"10b950d02426"></p>
<h3 local-id=3D"a51c900a7da7" id=3D"THENEHEMIZER-3.1Instru=C3=A7=C3=B5esDet=
alhadas">3.1 Instru=C3=A7=C3=B5es Detalhadas</h3>
<ol start=3D"1" local-id=3D"2794adc6-2ef5-4251-8a75-1433d5ef4695">
<li local-id=3D"80df7e45-c07d-48b6-8745-20d2601bc91b">
<p local-id=3D"aa16e85d2889"><strong>Acessar a Aplica=C3=A7=C3=A3o:</strong=
> Abra o navegador no endere=C3=A7o indicado (ex: <a class=3D"external-link=
" href=3D"https://the-nehemizer.streamlit.app/" rel=3D"nofollow">https://th=
e-nehemizer.streamlit.app/</a> ).</p></li>
<li local-id=3D"aad2cf99-3d57-44c4-8a97-5428b19875e8">
<p local-id=3D"c94d2313c8c6"><strong>Upload dos Arquivos:</strong></p>
<ul local-id=3D"e4b64e33-e9b4-47a6-bbc8-9ec46ed00c92">
<li local-id=3D"8aab93e9-46a4-470b-a174-cfa8601d466a">
<p local-id=3D"96fd76c66079"><strong>1=C2=BA Campo (Obrigat=C3=B3rio):</str=
ong> Selecione o arquivo Excel (<code>.xlsx</code>, <code>.xls</code>) ou <=
code>.csv</code> contendo o relat=C3=B3rio de vendas bruto.</p></li>
<li local-id=3D"9d37bded-73d0-44a3-9798-adddf7174cda">
<p local-id=3D"7f4ade7ffbc5"><strong>2=C2=BA Campo (Recomendado):</strong> =
Selecione um ou m=C3=BAltiplos arquivos PDF contendo as propostas/contratos=
 da BD.</p></li>
<li local-id=3D"19c1b5ae-19bb-4125-8893-441773297a9f">
<p local-id=3D"2f9150f7b733"><strong>3=C2=BA Campo (Opcional):</strong> Sel=
ecione a tabela de pre=C3=A7os normais (tabela padr=C3=A3o de compras).</p>=
</li>
</ul></li>
<li local-id=3D"af24819f-2e68-4b44-897f-68b3eb0343f4">
<p local-id=3D"5a955d4c6fe2"><strong>Confer=C3=AAncia da Pr=C3=A9via:</stro=
ng></p>
<ul local-id=3D"105a0d1e-2bb7-4a1e-9608-32988b000bfa">
<li local-id=3D"e03383b3-94b3-4c27-914c-86f3b3de0580">
<p local-id=3D"0500858ff963">Na se=C3=A7=C3=A3o <strong>"Pr=C3=A9via do Rel=
at=C3=B3rio (Aba RESUMO)"</strong>, o sistema exibe os dados consolidados.<=
/p></li>
<li local-id=3D"0a226c75-7b15-429e-a8cd-a60edfdd1c1d">
<p local-id=3D"bf60415cfcbc">Colunas como <code>CONTRATO_FINAL</code>, <cod=
e>SIGLA_RESUMO</code>, <code>QTDCOM</code> e <code>VLRTOTAL</code> ficam pr=
otegidas contra edi=C3=A7=C3=A3o para seguran=C3=A7a dos dados.</p></li>
<li local-id=3D"0f567c38-d096-424b-b5bc-18c36279d2f2">
<p local-id=3D"dd59fd8155cf">A coluna <code>PRECO_COMPRA_FINAL</code> aceit=
a altera=C3=A7=C3=A3o manual direta.</p></li>
</ul></li>
<li local-id=3D"061a73b3-9b9d-4827-b472-be27e1c9329a">
<p local-id=3D"576899c76f54"><strong>Gera=C3=A7=C3=A3o do Download:</strong=
></p>
<ul local-id=3D"b6c64791-4a6e-40c2-930b-c6d085a1fc07">
<li local-id=3D"5120df77-5564-43b7-ae5d-0b62035c14df">
<p local-id=3D"13a5c29ef73f">Clique no bot=C3=A3o <strong>"GERAR RELAT=C3=
=93RIO FINAL =F0=9F=93=A5"</strong>.</p></li>
<li local-id=3D"0c592394-a439-4343-849b-da6ca615d9f7">
<p local-id=3D"ab768126119e">O sistema acionar=C3=A1 uma anima=C3=A7=C3=A3o=
 de confirma=C3=A7=C3=A3o e exibir=C3=A1 o bot=C3=A3o verde <strong>"=F0=9F=
=93=84 Baixar Planilha Consolidada"</strong>.</p></li>
</ul></li>
</ol>
<hr local-id=3D"ae7c8f55-2f82-4e04-bf24-abc1fe6d43fa" data-layout=3D"wide" =
data-width=3D"760">
<h2 local-id=3D"c385bb5ee074" id=3D"THENEHEMIZER-=E2=9A=96=EF=B8=8F4.Regras=
deNeg=C3=B3cioeL=C3=B3gicadeMapeamento">=E2=9A=96=EF=B8=8F 4. Regras de Neg=
=C3=B3cio e L=C3=B3gica de Mapeamento</h2>
<h3 local-id=3D"9a471d87e1a2" id=3D"THENEHEMIZER-4.1De-ParadeClienteseContr=
atos">4.1 De-Para de Clientes e Contratos</h3>
